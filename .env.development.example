# Nestlancer frontend — development template (Infisical env: `dev`)
# cp .env.development.example .env.development
# Or: infisical export --env=dev --format=dotenv > .env.infisical
# Docs: docs/reference/environment-variables.md , docs/operations/secrets-infisical.md
#
# Do not store NODE_ENV in Infisical for local `next build` quirks — Next sets it per command.
# Secrets / keys left blank — fill from Infisical. Never commit real .env files.

NODE_ENV=development

# Server structured logs (stdout/stderr → docker logs). debug|info|warn|error
LOG_LEVEL=debug

# API & WebSocket
OPENAPI_GATEWAY_URL=https://api.demo.example
NEXT_PUBLIC_API_URL=https://api.demo.example
NEXT_PUBLIC_WS_URL=https://api.demo.example
NEXT_PUBLIC_SOCKET_IO_PATH=/ws/socket.io
API_UPSTREAM=https://api.demo.example
# true = browser calls same-origin /api/v1 (Next rewrite → API_UPSTREAM)
NEXT_PUBLIC_API_PROXY=true

# App URLs
NEXT_PUBLIC_APP_URL=https://app.demo.example
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.demo.example
NEXT_PUBLIC_WEB_URL=https://app.demo.example
NEXT_PUBLIC_LANDING_URL=https://landing.demo.example

# Integrations (must match nestlancer-backend-api)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_AUTH_REFRESH_BFF=true
# Production: set site key and omit bypass token. Dev may use bypass only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_BYPASS_TOKEN=demo-bypass-token
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# Storage: uploads go through the API gateway (S3-compatible only after BE d838052).
# Do not set MinIO-specific NEXT_PUBLIC_* vars — browsers never talk to object storage directly.
