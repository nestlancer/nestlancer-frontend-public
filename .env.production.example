# Nestlancer frontend — production template (Infisical env: `prod`)
# Import into Infisical or copy before deploy. Docs: docs/reference/environment-variables.md
# Or: INFISICAL_ENV=prod ./scripts/docker/compose-prod.sh up -d
#
# Secrets / keys left blank — fill from Infisical. Never commit real .env files.
# Do not store NODE_ENV in Infisical for image builds — Next sets it per command.

NODE_ENV=production

# Server structured logs (stdout/stderr → docker logs). debug|info|warn|error
LOG_LEVEL=info

# API & WebSocket (NEXT_PUBLIC_API_URL is per-app in Docker/K8s)
OPENAPI_GATEWAY_URL=https://api.demo.example
NEXT_PUBLIC_API_URL=https://app.demo.example
NEXT_PUBLIC_WS_URL=https://api.demo.example
# Socket.IO is served at NEXT_PUBLIC_WS_URL with path NEXT_PUBLIC_SOCKET_IO_PATH (/ws/socket.io).
# Do not probe bare /socket.io on the API host — it will 404 by design.
NEXT_PUBLIC_SOCKET_IO_PATH=/ws/socket.io
API_UPSTREAM=https://api.demo.example
# Server-side BFF upstream in Docker prod — override at runtime (not build time):
# API_UPSTREAM=http://host.docker.internal:4000
NEXT_PUBLIC_API_PROXY=true

# App URLs
NEXT_PUBLIC_APP_URL=https://app.demo.example
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.demo.example
NEXT_PUBLIC_WEB_URL=https://app.demo.example
NEXT_PUBLIC_LANDING_URL=https://demo.example

# Integrations (must match nestlancer-backend-api)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_AUTH_REFRESH_BFF=true
# Optional in Infisical prod today — set when Turnstile is enabled in production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=

# Docker image tags (docker-compose.prod.yml only — not required in Infisical)
NESTLANCER_IMAGE_REGISTRY=ghcr.io/demo-org
NESTLANCER_IMAGE_TAG=latest
