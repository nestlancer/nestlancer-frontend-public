{
  "name": "@nestlancer/admin",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 9010",
    "build": "next build",
    "start": "next start -p 9010",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mocked": "PLAYWRIGHT_SKIP_WEBSERVER=true playwright test tests/e2e/smoke.spec.ts tests/e2e/admin-users.mocked.spec.ts",
    "test:api": "node scripts/verify-admin-api.mjs",
    "test:api:pipeline": "node scripts/verify-pipeline-api.mjs",
    "test:api:all": "node scripts/verify-pipeline-api.mjs && node scripts/verify-admin-api.mjs",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@nestlancer/api-client": "workspace:*",
    "@nestlancer/auth": "workspace:*",
    "@nestlancer/config": "workspace:*",
    "@nestlancer/constants": "workspace:*",
    "@nestlancer/field-help": "workspace:*",
    "@nestlancer/theme": "workspace:*",
    "@nestlancer/types": "workspace:*",
    "@nestlancer/ui": "workspace:*",
    "@nestlancer/utils": "workspace:*",
    "@nestlancer/validators": "workspace:*",
    "@nestlancer/websocket": "workspace:*",
    "@tanstack/react-query": "^5.62.8",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
