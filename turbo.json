{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env.development",
    ".env.production",
    ".env.infisical",
    ".env.development.example",
    ".env.production.example"
  ],
  "globalEnv": ["NODE_ENV", "VERCEL_ENV", "API_UPSTREAM"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_*", "NODE_ENV", "API_UPSTREAM"]
    },
    "@nestlancer/api-client#build": {
      "outputs": []
    },
    "@nestlancer/auth#build": {
      "outputs": []
    },
    "@nestlancer/config#build": {
      "outputs": []
    },
    "@nestlancer/constants#build": {
      "outputs": []
    },
    "@nestlancer/field-help#build": {
      "outputs": []
    },
    "@nestlancer/hooks#build": {
      "outputs": []
    },
    "@nestlancer/theme#build": {
      "outputs": []
    },
    "@nestlancer/types#build": {
      "outputs": []
    },
    "@nestlancer/ui#build": {
      "outputs": []
    },
    "@nestlancer/utils#build": {
      "outputs": []
    },
    "@nestlancer/validators#build": {
      "outputs": []
    },
    "@nestlancer/websocket#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["test-results/**", "playwright-report/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["API_UPSTREAM", "NEXT_PUBLIC_*", "NODE_ENV"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
